<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="BETPREDICT · PONTUL ZILEI"
            android:textColor="#08F0C8" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
        <TextView android:id="@+id/w_upd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
            android:textColor="#5F6F86" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/w_pick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Se încarcă…"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_match" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
                android:textColor="#C3CEDE" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/w_odds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
            android:textColor="#08F0C8" android:textSize="26sp" android:textStyle="bold" android:fontFamily="monospace" android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
        android:textColor="#93A3B8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/w_pyr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=""
        android:textColor="#B9A2FF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp" />
</LinearLayout>
