def _load(name: str, default: Any = None) -> Any:
    try:
        with open(os.path.join(DATA, name), "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def _atomic_write(name: str, obj: Any) -> None:
    os.makedirs(DATA, exist_ok=True)
    path = os.path.join(DATA, name)
    fd, tmp = tempfile.mkstemp(dir=DATA, suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(obj, f, ensure_ascii=False, indent=2, default=str)
            f.write("\n")
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                pass


def _parse_dt(s: Any) -> Optional[datetime]:
    if not s:
        return None
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except Exception:
        return None


def _preferred_markets(adaptive: Optional[Dict] = None) -> Set[str]:
    preferred = set(PREFERRED_MARKETS_DEFAULT)
    by = (adaptive or {}).get("by_market") or {}
    for mk, rec in by.items():
        st = (rec or {}).get("stats") or {}
        n = int(st.get("n") or 0)
        roi = safe_float(st.get("roi_pct"), 0.0)
        if n >= 20 and roi >= 0:
            preferred.add(mk)
        if n >= 50 and roi <= -10:
            preferred.discard(mk)
    return preferred


def _consensus_ok(sig: Dict[str, Any], multi: bool) -> bool:
    tier = str(sig.get("consensus_tier") or "").upper()
    score = safe_float(sig.get("consensus_score"), -1.0)
    need = MIN_CONSENSUS_MULTI if multi else MIN_CONSENSUS_SINGLE
    grade = sig.get("quality_grade_v6") or sig.get("quality_grade") or "C"
    cal = safe_float(sig.get("calibrated_prob"), 0.0)
    if not cal:
        cal = _calibrated_prob(sig)

    if tier == "TOTAL":
        if score < 0:
            return True
        return score >= need or GRADE_RANK.get(grade, 0) >= 2
    if tier == "PARTIAL":
        return score >= need
    # Missing consensus: allow A+/A with solid cal; B only for singles with high cal
